# Gradle / Android build outputs
.gradle/
build/
app/build/
local.properties
*.iml
.idea/

# Release signing. keystore.properties holds the keystore path and its passwords;
# the keystore itself belongs outside the repo entirely, but ignore the extensions
# too so a stray copy can never be committed. See docs/android-signing.md.
keystore.properties
*.jks
*.keystore

# Generated assets (produced by prepare-assets.mjs from the Eupub renderer + dist)
app/src/main/assets/reader/
app/src/main/assets/engine/
app/src/main/assets/lexicon.db
app/src/main/assets/sample.epub
app/src/main/assets/pdf/
app/src/main/assets/pdfjs/
app/src/main/assets/*.pdf

# Real-world PDFs to test against (embedded fonts, JBIG2/JPEG2000 images).
# Drop any .pdf here and prepare-assets.mjs ships it into the APK. Personal and
# often large — the generator for the synthetic sample is test/make-pdf.js.
fixtures/
