{
  "name": "eupub",
  "version": "0.3.1",
  "description": "Eupub — a standalone EPUB/PDF/plain-text reader that renders books in euspell reformed spelling",
  "author": "Kamran Ossia",
  "license": "GPL-3.0-or-later",
  "main": "src/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:engine": "rollup -c rollup.engine.config.mjs",
    "build:engine:mobile": "rollup -c rollup.engine.mobile.config.mjs",
    "build:lexicon": "node build/copy-lexicon.js",
    "build:pdf": "node build/copy-pdf-viewer.mjs",
    "build:purify": "node build/copy-purify.js",
    "build": "npm run build:engine && npm run build:engine:mobile && npm run build:lexicon && npm run build:pdf && npm run build:purify && npm run build:sample",
    "start": "npm run build && electron .",
    "dev": "electron .",
    "test": "node --test test/android-bridge.test.js && npm run build && electron test/pipeline.js && electron test/text-pipeline.js && electron test/features.js && electron test/reader-e2e.js && electron test/engine-missing.js && electron test/non-linear.js && electron test/unreadable-chapter.js",
    "test:smoke": "electron test/smoke.js",
    "icon": "node build/make-icon.js",
    "package": "npm run build && node build/package.js",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "build:sample": "node build/make-sample.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.1",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1",
    "rollup": "^4.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "dompurify": "^3.4.12"
  },
  "build": {
    "appId": "org.euspell.eupub",
    "productName": "Eupub",
    "copyright": "GPL-3.0-or-later",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "dist/eupub-engine.mobile.js",
      "dist/lexicon.mjs",
      "dist/pdf/**",
      "dist/pdfjs/**",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "electronVersion": "33.4.11",
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "dist/sample.epub",
        "to": "sample.epub"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "eupub-Setup-${version}.${ext}",
      "fileAssociations": [
        {
          "ext": "epub",
          "name": "EPUB e-book",
          "description": "EPUB e-book",
          "mimeType": "application/epub+zip",
          "role": "Viewer"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.book",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "fileAssociations": [
        {
          "ext": "epub",
          "name": "EPUB Document",
          "role": "Viewer"
        }
      ]
    },
    "dmg": {
      "artifactName": "Eupub-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "mimeTypes": [
        "application/epub+zip",
        "application/pdf"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "eupub"
        }
      },
      "artifactName": "Eupub-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Eupub",
      "uninstallDisplayName": "Eupub ${version}"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true
  }
}
